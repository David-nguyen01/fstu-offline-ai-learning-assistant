# Copy this file to .env and use credentials for a SQL Server login that has
# read/write access to VietnameseCourseQA20DB. Never commit the real .env file.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=VietnameseCourseQA20DB;encrypt=true;trustServerCertificate=true
DB_USERNAME=courseqa_app_local
DB_PASSWORD=replace-with-a-strong-local-password
JWT_SECRET=replace-with-at-least-32-random-bytes-encoded-as-base64

SERVER_PORT=8080
PYTHON_AI_SERVICE_URL=http://localhost:8001
FRONTEND_BASE_URL=http://localhost:5173
OFFICIAL_RAGAS_ENABLED=false
